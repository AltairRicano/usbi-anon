{
  "name": "usbi-anon-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace=@usbi/engine && tsc --noEmit && vite build",

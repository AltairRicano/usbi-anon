# URL base de la API del backend. En desarrollo, vite.config.ts ya hace
# proxy de /api hacia VITE_BACKEND_URL (por defecto http://localhost:8088),
# así que este valor normalmente no hace falta tocarlo en local.
# VITE_API_BASE_URL=/api/v1

# Solo usado por vite.config.ts (server.proxy / preview.proxy), no por el
# código del cliente — no lleva prefijo consumible por import.meta.env.
# VITE_BACKEND_URL=http://localhost:8088

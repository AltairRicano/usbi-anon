# Variables de docker-compose.yml (M3 del plan de maduración). Copia este
# archivo a `.env` (gitignored) y rellena los valores reales — nunca edites
# docker-compose.yml directamente para cambiar un puerto o un secreto.
#
# Los seis secretos (JWT_SECRET, HMAC_SECRET, DB_SUPERUSER_PASSWORD,
# DB_APP_PASSWORD, DB_MODERADOR_PASSWORD, DB_MIGRATE_PASSWORD,
# DB_DBMAINT_PASSWORD) los genera `usbictl secrets init` — no los teclees a
# mano. Ver plan/00_Plan_de_maduracion.md, bloque M3.6.

# ── Puertos publicados al host ───────────────────────────────────────────
# Los valores por defecto (si no defines nada aquí) son los que ya se usan
# en el entorno de desarrollo actual — NO están confirmados como definitivos
# para producción. Cámbialos aquí en cuanto se decida el esquema real;
# docker-compose.yml no necesita tocarse.
HOST_WEB_PORT=8092
HOST_API_PORT=8093
HOST_DB_PORT=5435

# ADVERTENCIA (M3.2): publicar Postgres directo al host (HOST_DB_PORT) es
# aceptable en un entorno de desarrollo detrás de una red controlada, pero
# es inaceptable en cuanto el VPS tenga una IP pública real. Antes de ese
# despliegue, comenta el bloque `ports` del servicio `db` en
# docker-compose.yml en vez de solo cambiar este puerto — nada dentro de la
# red `internal` del compose necesita que este puerto salga del host.

# ── Origen permitido para CORS ───────────────────────────────────────────
# Con nginx (servicio web) proxyando /api sobre el mismo origen, la SPA
# nunca hace una petición cross-origin real — este valor solo importa para
# clientes distintos del propio frontend servido aquí (pruebas manuales,
# la futura app de escritorio si algún día usa un origin no vacío).
CORS_ALLOWED_ORIGIN=http://localhost:8092

# TRUST_PROXY_HEADERS=false mientras nginx sea el único proxy inverso y siga
# corriendo en el mismo compose (ver comentario en internal/transport/router.go).
TRUST_PROXY_HEADERS=false

# ── Red interna de docker compose ────────────────────────────────────────
COMPOSE_NETWORK_CIDR=172.28.0.0/16

# ── Memoria de Postgres (M3.7) ───────────────────────────────────────────
# Calculados para el VPS de referencia del plan (1 vCPU, 1 GB RAM, 20 GB
# disco) con la misma fórmula que `usbictl pgconf render --total-ram-mb N`
# (~35% de la RAM total para Postgres, compartida con api/web). Recalcula
# ambos en cuanto se confirme el tamaño real contratado.
PG_SHARED_BUFFERS=89MB
PG_EFFECTIVE_CACHE_SIZE=268MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=44MB
PG_MAX_CONNECTIONS=20

# ── Secretos (usbictl secrets init los genera — no editar a mano) ───────
JWT_SECRET=
HMAC_SECRET=
DB_SUPERUSER_PASSWORD=
DB_APP_PASSWORD=
DB_MODERADOR_PASSWORD=
DB_MIGRATE_PASSWORD=
DB_DBMAINT_PASSWORD=
